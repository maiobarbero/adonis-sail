  minio:
    image: 'minio/minio:latest'
    ports:
      - '${MINIO_PORT:-9000}:9000'
      - '${MINIO_CONSOLE_PORT:-8900}:8900'
    environment:
      MINIO_ROOT_USER: 'sail'
      MINIO_ROOT_PASSWORD: 'password'
    volumes:
      - 'sailminio:/data/minio'
    networks:
      - sail
    command: minio server /data/minio --console-address ":8900"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      retries: 3
      timeout: 5s

// Throwaway container to do the bucket setup
createbuckets:
  image: 'minio/mc:latest'
  depends_on:
    - minio
  entrypoint: >
    /bin/sh -c "
    sleep 3;
    mc alias set sail http://minio:9000 sail password;
    mc mb sail/${S3_BUCKET:-local};
    exit 0;
    "
  environment:
    - S3_BUCKET=${S3_BUCKET:-local}
  networks:
    - sail
